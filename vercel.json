{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "redirects": [
    {
      "source": "/(ADINA|Adina)(.*)Resume(.*)\\.pdf",
      "destination": "/resume-adina-fayza-gayo.pdf",
      "permanent": false
    }
  ]
}
